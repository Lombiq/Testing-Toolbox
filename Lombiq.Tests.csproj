<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../src/Utilities/Lombiq.MSBuild.Targets/Lombiq.MSBuild.Library.Sdk/Sdk/Import.props" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.props" Sdk="Lombiq.MSBuild.Library.Sdk" Version="2.0.1" />

  <PropertyGroup>
    <Title>Lombiq Testing Toolbox for Orchard Core</Title>
    <CopyrightYear>2020</CopyrightYear>
    <DescriptionBody>General and unit testing extensions and helpers, mostly for ASP.NET Core and Orchard Core.</DescriptionBody>
    <PackageTags>OrchardCore;Lombiq;AspNetCore;Moq;xUnit;UnitTesting;Testing</PackageTags>
    <RepositoryUrl>https://github.com/Lombiq/Testing-Toolbox</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit.v3.extensibility.core" Version="4.0.0" />
    <!-- Kept on 4.0.2: 4.0.3's Moq.AutoMocker.Generators analyzer requires a newer Roslyn than the NuGet packaging
         pipeline's compiler supports, breaking "dotnet pack" with CS9057. -->
    <PackageReference Include="Moq.AutoMock" Version="4.0.2" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <!-- These are necessary for symbols NuGet packaging, otherwise Shouldly would prevent PDBs to be packaged, see:
  https://github.com/NuGet/Home/discussions/11541. -->
  <PropertyGroup Condition="'$(NuGetBuild)' == 'true'">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
  </PropertyGroup>

  <Import Condition="'$(NuGetBuild)' != 'true'" Project="../../src/Utilities/Lombiq.MSBuild.Targets/Lombiq.MSBuild.Library.Sdk/Sdk/Import.targets" />
  <Import Condition="'$(NuGetBuild)' == 'true'" Project="Sdk.targets" Sdk="Lombiq.MSBuild.Library.Sdk" Version="2.0.1" />
</Project>
